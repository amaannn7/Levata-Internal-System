# Dev junk
error_log
.DS_Store
.claude/
node_modules/
pptx-build/
_*.png
_*.js
_*.html
.data-backup-*/

# Runtime-generated files (auto-recreate — don't ship)
data/.rate_limits.json
data/chat_last_read_*.json
data/uploads/*
!data/uploads/.gitkeep

# SSL validation challenge files (created by AutoSSL/Let's Encrypt on the server)
.well-known/

# Sensitive data — NEVER commit (contains API keys, passwords, tokens, lead data)
data/admin.json
data/users.json
data/user_*.json
data/documents.json
data/jobs.json
data/*.json
# Keep example/seed files if you add any later (none yet)

# PostgreSQL credentials — local dev password AND production credentials both
# live in this file. Deploy the real one to cPanel via File Manager, never git.
# See db.example.php for the template that DOES get committed.
db.php
db.production.php

# Deployment zip (build artifact for manual cPanel upload) — regenerate, don't commit.
levata-deploy.zip

# One-time user migration script — contains real password hashes + device tokens.
# Run once on the live server, then delete it there too. Never commit.
migrate-users.php

# Database dumps — contain real password hashes, API keys, device tokens, lead
# data. Used for local-dev -> production migration only. Delete after import,
# never commit, never leave sitting on a server after use.
*.sql
levata_local_dump.sql
